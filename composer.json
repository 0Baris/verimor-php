{
  "name": "bariscemant/verimor",
  "description": "Unofficial community PHP SDK for Verimor SMS, Switch and WhatsApp APIs",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^7.4 || ^8.0",
    "guzzlehttp/guzzle": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^1.12 || ^2.0",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "BarisCemant\\Verimor\\": "src/"
    },
    "classmap": [
      "src/Sms/Dto",
      "src/Sms/Service",
      "src/Sms/RawApis.gen.php",
      "src/SwitchApi/Dto",
      "src/SwitchApi/Service",
      "src/SwitchApi/RawApis.gen.php",
      "src/WhatsApp/Dto",
      "src/WhatsApp/Service",
      "src/WhatsApp/RawApis.gen.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "BarisCemant\\Verimor\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "style": "phpcs",
    "check": [
      "@test",
      "@analyse",
      "@style"
    ]
  },
  "archive": {
    "exclude": [
      "/.github",
      "/build",
      "/docker",
      "/spec",
      "/tests",
      "/vendor",
      "/composer.lock",
      "/phpunit.xml.dist",
      "/phpcs.xml.dist",
      "/phpstan.neon.dist",
      "/php-sdk-export.json",
      "/scripts/test-consumer.php",
      "/scripts/generate*"
    ]
  },
  "prefer-stable": true
}
